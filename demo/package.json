{
  "name": "makora-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "capture": "bun scripts/capture.ts",
    "dev": "remotion studio src/index.ts --port=3001",
    "check": "tsc --noEmit",
    "render": "remotion render src/index.ts MakoraDemo out/makora-demo.mp4 --codec=h264 --crf=18 --concurrency=2",
    "poster": "remotion still src/index.ts MakoraDemo out/poster.png --frame=1215"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
