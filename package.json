{
  "name": "makora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "ext:build": "node extensions/browser/build.mjs",
    "ext:watch": "node extensions/browser/build.mjs --watch",
    "ext:check": "tsc -p extensions/browser",
    "demo:install": "bun install --cwd demo",
    "demo:capture": "bun run --cwd demo capture",
    "demo:dev": "bun run --cwd demo dev",
    "demo:check": "bun run --cwd demo check",
    "demo:render": "bun run --cwd demo render",
    "check": "biome check --write",
    "format": "biome format",
    "lint": "biome lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "lefthook": "^2.2.2",
    "typescript": "~7.0.2"
  }
}
