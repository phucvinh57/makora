{
  "manifest_version": 3,
  "name": "Makora's tab reporter",
  "version": "0.1.0",
  "description": "Reports active tab URLs to Makora's local collector to split browser time by site. Nothing leaves your machine.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Makora's tab reporter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:47632/*"],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-reporter@makora.dev",
      "strict_min_version": "109.0"
    }
  }
}
