{
  "manifest_version": 3,
  "name": "Makora's tab reporter",
  "version": "0.2.0",
  "description": "Reports the active tab to the Makora desktop app to split browser time by site. Nothing leaves your machine.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Makora's tab reporter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["tabs", "nativeMessaging"],
  "minimum_chrome_version": "121",
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-reporter@makora.dev",
      "strict_min_version": "109.0"
    }
  }
}
