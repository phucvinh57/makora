{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Makora",
  "version": "0.1.0",
  "identifier": "dev.phucvinh57.makora",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../" },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Makora",
        "width": 1000,
        "height": 700,
        "minWidth": 900,
        "minHeight": 620,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/gnome-shell/extensions/makora@phucvinh57.dev/metadata.json": "../gnome-extension/metadata.json",
          "/usr/share/gnome-shell/extensions/makora@phucvinh57.dev/extension.js": "../gnome-extension/extension.js"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/gnome-shell/extensions/makora@phucvinh57.dev/metadata.json": "../gnome-extension/metadata.json",
          "/usr/share/gnome-shell/extensions/makora@phucvinh57.dev/extension.js": "../gnome-extension/extension.js"
        }
      }
    }
  }
}
