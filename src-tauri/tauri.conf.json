{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Makora",
  "version": "0.1.0",
  "identifier": "dev.phucvinh57.makora",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../" },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Makora",
        "width": 1000,
        "height": 700,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
